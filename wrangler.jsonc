{
  "name": "wheres-mc-graeballs",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "graeballs-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": { "TURNSTILE_SITE_KEY": "1x00000000000000000000AA" },
  "observability": { "enabled": true }
  // Custom domains are added at deploy time (see README):
  // "routes": [
  //   { "pattern": "wheresmcgraeballs.co.uk", "custom_domain": true },
  //   { "pattern": "www.wheresmcgraeballs.co.uk", "custom_domain": true }
  // ]
}
